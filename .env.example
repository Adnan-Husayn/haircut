# Solana RPC for SCRIPTS (npm run probe / npm run oracle).
# Loaded via `node --env-file=.env`. Never committed.
RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Local development only. Vite inlines any VITE_* variable into the client
# bundle, so setting this in a deployed build publishes your key.
# Leave it UNSET in production: the browser needs one getMultipleAccounts call
# for the staleness panel, which the public endpoint handles fine.
# VITE_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
